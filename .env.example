# PostgreSQL
POSTGRES_DB=equipment_management
POSTGRES_USER=equipment_user
POSTGRES_PASSWORD=change-this-local-development-password

# Host ports (change these only when a port is already occupied)
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# At least 32 characters. Change for every deployed environment.
APP_JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

